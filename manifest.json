{
  "manifest_version": 3,
  "name": "CCFOLIA 拡張ルームチャット",
  "version": "1.0.0",
  "description": "CCFOLIAをより便利に！",
  "permissions": ["tabs", "storage", "notifications"],
  "host_permissions": ["https://ccfolia.com/*"],
  "action": {
    "default_title": "CCFOLIA 拡張ルームチャット",
    "default_icon": { "48": "icon.png", "128": "icon.png" }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://ccfolia.com/rooms/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["control.html", "control.css", "control.js"],
      "matches": ["https://ccfolia.com/*"]
    }
  ]
}
