{
  "manifest_version": 3,
  "name": "CCFOLIA ステータス変更",
  "version": "1.0.0",
  "description": "CCFOLIAの盤面キャラクター全員のHP・MP・SANを変更する非公式拡張機能",
  "permissions": ["tabs", "storage"],
  "host_permissions": ["https://ccfolia.com/*"],
  "action": {
    "default_title": "CCFOLIA ステータス変更"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://ccfolia.com/rooms/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
